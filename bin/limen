#!/bin/sh
set -eu

emacsclient=${EMACSCLIENT:-emacsclient}

help() {
    cat <<'EOF'
Limen
Expose Emacs functionality to local agents.

Usage: limen <COMMAND>

Commands:
  context      Read the current Emacs context in one call
  focus        Read the selected Emacs focus state
  trail        List recently visited Emacs buffers
  buffer       Work with Emacs buffers
  compile      Inspect Emacs compilation buffers
  annotations  Inspect scholia annotation sessions
  windows      List Emacs windows
  diagnostics  List Flymake diagnostics
  projects     List known projects
  skill        Generate agent instructions
  hook         Answer an agent prompt hook with Emacs context
  eval         Evaluate explicitly enabled Emacs Lisp
  help         Print help for a command

Options:
  -h, --help  Print help
EOF
}

skill_help() {
    cat <<'EOF'
Generate agent instructions for available Emacs commands.

Usage: limen skill

Options:
  -h, --help  Print help
EOF
}

hook_help() {
    cat <<'EOF'
Answer a Claude Code or Codex prompt hook with Emacs context.

Reads the hook payload from standard input and prints the hook's JSON
output.  Does nothing unless LIMEN_SESSION or HERDR_ENV=1 is set, gives
up silently when Emacs does not answer within LIMEN_HOOK_TIMEOUT seconds
(3 by default), and never fails the prompt: every error exits 0 without
output.

Usage: limen hook <PROVIDER>

Arguments:
  <PROVIDER>  claude or codex

Options:
  -h, --help  Print help
EOF
}

context_help() {
    cat <<'EOF'
Read the current Emacs context in one call.

Usage: limen context [OPTIONS]

Options:
      --section <NAME>  Include only this section; repeatable
  -h, --help            Print help
EOF
}

trail_help() {
    cat <<'EOF'
List recently visited Emacs buffers with settled point traces.

Requires limen-trail-mode in Emacs.

Usage: limen trail [OPTIONS]

Options:
      --limit <N>  Return at most N entries
  -h, --help       Print help
EOF
}

focus_help() {
    cat <<'EOF'
Read the selected Emacs focus state.

Usage: limen focus

Options:
  -h, --help  Print help
EOF
}

compile_help() {
    cat <<'EOF'
Inspect existing Emacs compilation buffers.

Usage: limen compile <COMMAND>

Commands:
  list           List compilation buffers
  read <BUFFER>  Read a compilation buffer output tail

Options:
  -h, --help  Print help
EOF
}

compile_list_help() {
    cat <<'EOF'
List existing Emacs compilation buffers.

Usage: limen compile list

Options:
  -h, --help  Print help
EOF
}

compile_read_help() {
    cat <<'EOF'
Read a bounded output tail from an existing Emacs compilation buffer.

Usage: limen compile read <BUFFER>

Arguments:
  <BUFFER>  Compilation buffer name

Options:
  -h, --help  Print help
EOF
}

annotations_help() {
    cat <<'EOF'
Inspect scholia annotation sessions.

Usage: limen annotations <COMMAND>

Commands:
  sessions          List sessions with project-confined file counts
  list [OPTIONS]    List annotations from visible or named sessions
  export [OPTIONS]  Render a session's annotations in an export format

Options:
  -h, --help  Print help
EOF
}

annotations_sessions_help() {
    cat <<'EOF'
List scholia sessions with project-confined file counts.

Usage: limen annotations sessions

Options:
  -h, --help  Print help
EOF
}

annotations_list_help() {
    cat <<'EOF'
List scholia annotations, confined to the project.

Usage: limen annotations list [OPTIONS]

Options:
      --session <NAME>  Session name; omit for the visible sessions
      --path <PATH>     Project-relative or absolute file path
      --limit <N>       Return at most N annotations
  -h, --help            Print help
EOF
}

annotations_export_help() {
    cat <<'EOF'
Render a scholia session's project-confined annotations.

Usage: limen annotations export --session <NAME> [OPTIONS]

Options:
      --session <NAME>   Session name
      --path <PATH>      Restrict the rendering to one file
      --format <FORMAT>  rustc (default), diff, or integrate
  -h, --help             Print help
EOF
}

buffer_help() {
    cat <<'EOF'
Work with Emacs buffers.

Usage: limen buffer <COMMAND>

Commands:
  list [OPTIONS]            List live buffers
  read <PATH> [OPTIONS]     Read a live buffer
  save <PATH> [OPTIONS]     Save a live file buffer
  open <PATH> [OPTIONS]     Open a file

Options:
  -h, --help  Print help
EOF
}

buffer_list_help() {
    cat <<'EOF'
List live Emacs buffers.

Usage: limen buffer list [OPTIONS]

Options:
      --virtual  List virtual buffers only
      --all      List file and virtual buffers
  -h, --help     Print help
EOF
}

buffer_read_help() {
    cat <<'EOF'
Read text from a live Emacs buffer.

Usage: limen buffer read <PATH> [OPTIONS]
       limen buffer read --name <NAME> [OPTIONS]

Arguments:
  <PATH>  Project-relative or absolute file path

Options:
      --name <NAME>            Select a buffer by name
      --line <LINE>            One-based start line
      --end-line <END_LINE>    One-based end line
      --widen                  Temporarily ignore buffer narrowing
      --expected-tick <TICK>   Require the current modification tick
  -h, --help                   Print help
EOF
}

buffer_save_help() {
    cat <<'EOF'
Save a visited file buffer if its state is current.

Usage: limen buffer save <PATH> --expected-tick <TICK>

Arguments:
  <PATH>  Project-relative or absolute file path

Options:
      --expected-tick <TICK>  Required current modification tick
  -h, --help                  Print help
EOF
}

buffer_open_help() {
    cat <<'EOF'
Open a file in an Emacs buffer.

Usage: limen buffer open <PATH> [OPTIONS]

Arguments:
  <PATH>  Project-relative or absolute file path

Options:
      --line <LINE>              One-based start line
      --column <COLUMN>          Zero-based start column
      --end-line <END_LINE>      One-based end line
      --start-text <START_TEXT>  Text locating the start
      --end-text <END_TEXT>      Text locating the end
  -h, --help                     Print help
EOF
}

windows_help() {
    cat <<'EOF'
List Emacs windows.

Usage: limen windows

Options:
  -h, --help  Print help
EOF
}

diagnostics_help() {
    cat <<'EOF'
List already computed Emacs diagnostics.

Usage: limen diagnostics [--uri <URI>]

Options:
      --uri <URI>  Restrict diagnostics to a file URI
  -h, --help       Print help
EOF
}

projects_help() {
    cat <<'EOF'
List known projects from Projectile or project.el.

Usage: limen projects

Options:
  -h, --help  Print help
EOF
}

eval_help() {
    cat <<'EOF'
Evaluate explicitly enabled Emacs Lisp.

Usage: limen eval <CODE|->

Arguments:
  <CODE|->  Emacs Lisp source, or - to read from standard input

Options:
  -h, --help  Print help
EOF
}

usage() {
    "$1" >&2
    exit 2
}

show_help() {
    case $# in
        0) help ;;
        1)
            case $1 in
                context) context_help ;;
                focus) focus_help ;;
                trail) trail_help ;;
                buffer) buffer_help ;;
                compile) compile_help ;;
                annotations) annotations_help ;;
                windows) windows_help ;;
                diagnostics) diagnostics_help ;;
                projects) projects_help ;;
                skill) skill_help ;;
                hook) hook_help ;;
                eval) eval_help ;;
                *) usage help ;;
            esac
            ;;
        2)
            case "$1 $2" in
                "buffer open") buffer_open_help ;;
                "buffer list") buffer_list_help ;;
                "buffer read") buffer_read_help ;;
                "buffer save") buffer_save_help ;;
                "compile list") compile_list_help ;;
                "compile read") compile_read_help ;;
                "annotations sessions") annotations_sessions_help ;;
                "annotations list") annotations_list_help ;;
                "annotations export") annotations_export_help ;;
                *) usage help ;;
            esac
            ;;
        *) usage help ;;
    esac
}

encode() {
    base64 | tr -d '\n'
}

decode() {
    if printf '' | base64 --decode >/dev/null 2>&1; then
        base64 --decode
    else
        base64 -D
    fi
}

argument_fields=

append_argument() {
    if [ -n "$argument_fields" ]; then
        argument_fields="$argument_fields,$1"
    else
        argument_fields=$1
    fi
}

add_string_argument() {
    encoded_argument=$(printf '%s' "$2" | encode)
    append_argument "\"$1\":{\"base64\":\"$encoded_argument\"}"
}

add_integer_argument() {
    integer=$2
    sign=
    case $integer in
        -*) sign=-; digits=${integer#-} ;;
        *) digits=$integer ;;
    esac
    case $digits in
        ''|*[!0-9]*) usage "$3" ;;
    esac
    while [ "${digits#0}" != "$digits" ] && [ "$digits" != 0 ]; do
        digits=${digits#0}
    done
    append_argument "\"$1\":$sign$digits"
}

method=
operation=
arguments='{}'
quiet=

fail() {
    if [ -n "$quiet" ]; then
        exit 0
    fi
    printf '%s\n' "$1" >&2
    exit "$2"
}

case ${1-} in
    ''|-h|--help)
        [ "$#" -le 1 ] || usage help
        help
        exit 0
        ;;
    help)
        shift
        show_help "$@"
        exit 0
        ;;
    skill)
        case ${2-} in
            '' ) [ "$#" -eq 1 ] || usage skill_help ;;
            -h|--help) [ "$#" -eq 2 ] || usage skill_help; skill_help; exit 0 ;;
            *) usage skill_help ;;
        esac
        method=skill
        ;;
    hook)
        case ${2-} in
            -h|--help) [ "$#" -eq 2 ] || usage hook_help; hook_help; exit 0 ;;
            claude|codex) [ "$#" -eq 2 ] || usage hook_help ;;
            *) usage hook_help ;;
        esac
        if [ -z "${LIMEN_SESSION:-}" ] && [ "${HERDR_ENV:-}" != 1 ]; then
            exit 0
        fi
        method=hook
        provider=$2
        quiet=true
        payload_base64=$(encode)
        session_base64=$(printf '%s' "${LIMEN_SESSION:-}" | encode)
        server_base64=$(printf '%s' "${HERDR_SOCKET_PATH:-}" | encode)
        pane_base64=$(printf '%s' "${HERDR_PANE_ID:-}" | encode)
        ;;
    focus)
        case ${2-} in
            '') [ "$#" -eq 1 ] || usage focus_help ;;
            -h|--help) [ "$#" -eq 2 ] || usage focus_help; focus_help; exit 0 ;;
            *) usage focus_help ;;
        esac
        method=call
        operation=focus.get
        ;;
    context)
        case ${2-} in -h|--help) [ "$#" -eq 2 ] || usage context_help; context_help; exit 0 ;; esac
        method=call
        operation=context.get
        sections=
        shift
        while [ "$#" -gt 0 ]; do
            case $1 in
                --section)
                    [ "$#" -ge 2 ] || usage context_help
                    case $2 in
                        ''|*[!abcdefghijklmnopqrstuvwxyz_-]*) usage context_help ;;
                    esac
                    if [ -n "$sections" ]; then
                        sections="$sections,\"$2\""
                    else
                        sections="\"$2\""
                    fi
                    shift 2
                    ;;
                *) usage context_help ;;
            esac
        done
        if [ -n "$sections" ]; then
            arguments="{\"sections\":[$sections]}"
        fi
        ;;
    trail)
        case ${2-} in -h|--help) [ "$#" -eq 2 ] || usage trail_help; trail_help; exit 0 ;; esac
        method=call
        operation=trail.list
        argument_fields=
        limit_seen=
        shift
        while [ "$#" -gt 0 ]; do
            case $1 in
                --limit)
                    [ "$#" -ge 2 ] && [ -z "$limit_seen" ] || usage trail_help
                    limit_seen=true
                    add_integer_argument limit "$2" trail_help
                    shift 2
                    ;;
                *) usage trail_help ;;
            esac
        done
        arguments="{$argument_fields}"
        ;;
    compile)
        case ${2-} in
            ''|-h|--help)
                [ "$#" -le 2 ] || usage compile_help
                compile_help
                exit 0
                ;;
            list)
                case ${3-} in
                    '') [ "$#" -eq 2 ] || usage compile_list_help ;;
                    -h|--help)
                        [ "$#" -eq 3 ] || usage compile_list_help
                        compile_list_help
                        exit 0
                        ;;
                    *) usage compile_list_help ;;
                esac
                method=call
                operation=compile.list
                ;;
            read)
                case ${3-} in
                    '' ) usage compile_read_help ;;
                    -h|--help)
                        [ "$#" -eq 3 ] || usage compile_read_help
                        compile_read_help
                        exit 0
                        ;;
                    --*) usage compile_read_help ;;
                    *)
                        [ "$#" -eq 3 ] || usage compile_read_help
                        method=call
                        operation=compile.read
                        argument_fields=
                        add_string_argument name "$3"
                        arguments="{$argument_fields}"
                        ;;
                esac
                ;;
            *) usage compile_help ;;
        esac
        ;;
    annotations)
        case ${2-} in
            ''|-h|--help)
                [ "$#" -le 2 ] || usage annotations_help
                annotations_help
                exit 0
                ;;
            sessions)
                case ${3-} in
                    '') [ "$#" -eq 2 ] || usage annotations_sessions_help ;;
                    -h|--help)
                        [ "$#" -eq 3 ] || usage annotations_sessions_help
                        annotations_sessions_help
                        exit 0
                        ;;
                    *) usage annotations_sessions_help ;;
                esac
                method=call
                operation=annotation.sessions
                ;;
            list)
                case ${3-} in -h|--help) [ "$#" -eq 3 ] || usage annotations_list_help; annotations_list_help; exit 0 ;; esac
                method=call
                operation=annotation.list
                argument_fields=
                session_seen=
                path_seen=
                limit_seen=
                shift 2
                while [ "$#" -gt 0 ]; do
                    case $1 in
                        --session)
                            [ "$#" -ge 2 ] && [ -z "$session_seen" ] || usage annotations_list_help
                            session_seen=true
                            add_string_argument session "$2"
                            shift 2
                            ;;
                        --path)
                            [ "$#" -ge 2 ] && [ -z "$path_seen" ] || usage annotations_list_help
                            path_seen=true
                            add_string_argument path "$2"
                            shift 2
                            ;;
                        --limit)
                            [ "$#" -ge 2 ] && [ -z "$limit_seen" ] || usage annotations_list_help
                            limit_seen=true
                            add_integer_argument limit "$2" annotations_list_help
                            shift 2
                            ;;
                        *) usage annotations_list_help ;;
                    esac
                done
                arguments="{$argument_fields}"
                ;;
            export)
                case ${3-} in -h|--help) [ "$#" -eq 3 ] || usage annotations_export_help; annotations_export_help; exit 0 ;; esac
                method=call
                operation=annotation.export
                argument_fields=
                session_seen=
                path_seen=
                format_seen=
                shift 2
                while [ "$#" -gt 0 ]; do
                    case $1 in
                        --session)
                            [ "$#" -ge 2 ] && [ -z "$session_seen" ] || usage annotations_export_help
                            session_seen=true
                            add_string_argument session "$2"
                            shift 2
                            ;;
                        --path)
                            [ "$#" -ge 2 ] && [ -z "$path_seen" ] || usage annotations_export_help
                            path_seen=true
                            add_string_argument path "$2"
                            shift 2
                            ;;
                        --format)
                            [ "$#" -ge 2 ] && [ -z "$format_seen" ] || usage annotations_export_help
                            case $2 in
                                rustc|diff|integrate) ;;
                                *) usage annotations_export_help ;;
                            esac
                            format_seen=true
                            append_argument "\"format\":\"$2\""
                            shift 2
                            ;;
                        *) usage annotations_export_help ;;
                    esac
                done
                [ -n "$session_seen" ] || usage annotations_export_help
                arguments="{$argument_fields}"
                ;;
            *) usage annotations_help ;;
        esac
        ;;
    buffer)
        case ${2-} in
            ''|-h|--help)
                [ "$#" -le 2 ] || usage buffer_help
                buffer_help
                exit 0
                ;;
            list)
                case ${3-} in -h|--help) [ "$#" -eq 3 ] || usage buffer_list_help; buffer_list_help; exit 0 ;; esac
                method=call
                operation=buffer.list
                argument_fields=
                selection=
                shift 2
                while [ "$#" -gt 0 ]; do
                    case $1 in
                        --virtual)
                            [ -z "$selection" ] || usage buffer_list_help
                            selection=virtual
                            append_argument '"virtual":true'
                            ;;
                        --all)
                            [ -z "$selection" ] || usage buffer_list_help
                            selection=all
                            append_argument '"all":true'
                            ;;
                        *) usage buffer_list_help ;;
                    esac
                    shift
                done
                arguments="{$argument_fields}"
                ;;
            read)
                case ${3-} in -h|--help) [ "$#" -eq 3 ] || usage buffer_read_help; buffer_read_help; exit 0 ;; esac
                method=call
                operation=buffer.read
                argument_fields=
                selector=
                line_seen=
                end_line_seen=
                widen_seen=
                expected_tick_seen=
                shift 2
                while [ "$#" -gt 0 ]; do
                    option=$1
                    case $option in
                        --name)
                            [ "$#" -ge 2 ] && [ -z "$selector" ] || usage buffer_read_help
                            selector=name
                            add_string_argument name "$2"
                            shift 2
                            ;;
                        --line)
                            [ "$#" -ge 2 ] && [ -z "$line_seen" ] || usage buffer_read_help
                            line_seen=true
                            add_integer_argument line "$2" buffer_read_help
                            shift 2
                            ;;
                        --end-line)
                            [ "$#" -ge 2 ] && [ -z "$end_line_seen" ] || usage buffer_read_help
                            end_line_seen=true
                            add_integer_argument end_line "$2" buffer_read_help
                            shift 2
                            ;;
                        --widen)
                            [ -z "$widen_seen" ] || usage buffer_read_help
                            widen_seen=true
                            append_argument '"widen":true'
                            shift
                            ;;
                        --expected-tick)
                            [ "$#" -ge 2 ] && [ -z "$expected_tick_seen" ] || usage buffer_read_help
                            expected_tick_seen=true
                            add_integer_argument expected_tick "$2" buffer_read_help
                            shift 2
                            ;;
                        --*) usage buffer_read_help ;;
                        *)
                            [ -z "$selector" ] || usage buffer_read_help
                            selector=path
                            add_string_argument path "$option"
                            shift
                            ;;
                    esac
                done
                [ -n "$selector" ] || usage buffer_read_help
                arguments="{$argument_fields}"
                ;;
            save)
                case ${3-} in -h|--help) [ "$#" -eq 3 ] || usage buffer_save_help; buffer_save_help; exit 0 ;; esac
                [ "$#" -ge 3 ] || usage buffer_save_help
                case $3 in --*) usage buffer_save_help ;; esac
                method=call
                operation=buffer.save
                argument_fields=
                add_string_argument path "$3"
                expected_tick_seen=
                shift 3
                while [ "$#" -gt 0 ]; do
                    case $1 in
                        --expected-tick)
                            [ "$#" -ge 2 ] && [ -z "$expected_tick_seen" ] || usage buffer_save_help
                            expected_tick_seen=true
                            add_integer_argument expected_tick "$2" buffer_save_help
                            shift 2
                            ;;
                        *) usage buffer_save_help ;;
                    esac
                done
                [ -n "$expected_tick_seen" ] || usage buffer_save_help
                arguments="{$argument_fields}"
                ;;
            open)
                case ${3-} in -h|--help) [ "$#" -eq 3 ] || usage buffer_open_help; buffer_open_help; exit 0 ;; esac
                [ "$#" -ge 3 ] || usage buffer_open_help
                method=call
                operation=buffer.open
                argument_fields=
                add_string_argument path "$3"
                line_seen=
                column_seen=
                end_line_seen=
                start_text_seen=
                end_text_seen=
                shift 3
                while [ "$#" -gt 0 ]; do
                    option=$1
                    [ "$#" -ge 2 ] || usage buffer_open_help
                    case $option in
                        --line)
                            [ -z "$line_seen" ] || usage buffer_open_help
                            line_seen=true
                            add_integer_argument line "$2" buffer_open_help
                            ;;
                        --column)
                            [ -z "$column_seen" ] || usage buffer_open_help
                            column_seen=true
                            add_integer_argument column "$2" buffer_open_help
                            ;;
                        --end-line)
                            [ -z "$end_line_seen" ] || usage buffer_open_help
                            end_line_seen=true
                            add_integer_argument end_line "$2" buffer_open_help
                            ;;
                        --start-text)
                            [ -z "$start_text_seen" ] || usage buffer_open_help
                            start_text_seen=true
                            add_string_argument start_text "$2"
                            ;;
                        --end-text)
                            [ -z "$end_text_seen" ] || usage buffer_open_help
                            end_text_seen=true
                            add_string_argument end_text "$2"
                            ;;
                        *) usage buffer_open_help ;;
                    esac
                    shift 2
                done
                arguments="{$argument_fields}"
                ;;
            *) usage buffer_help ;;
        esac
        ;;
    windows)
        case ${2-} in
            '' ) [ "$#" -eq 1 ] || usage windows_help ;;
            -h|--help) [ "$#" -eq 2 ] || usage windows_help; windows_help; exit 0 ;;
            *) usage windows_help ;;
        esac
        method=call
        operation=window.list
        ;;
    diagnostics)
        case ${2-} in
            -h|--help)
                [ "$#" -eq 2 ] || usage diagnostics_help
                diagnostics_help
                exit 0
                ;;
        esac
        method=call
        operation=diagnostic.list
        argument_fields=
        shift
        while [ "$#" -gt 0 ]; do
            [ "$1" = '--uri' ] && [ "$#" -eq 2 ] || usage diagnostics_help
            add_string_argument uri "$2"
            shift 2
        done
        arguments="{$argument_fields}"
        ;;
    projects)
        case ${2-} in
            '' ) [ "$#" -eq 1 ] || usage projects_help ;;
            -h|--help) [ "$#" -eq 2 ] || usage projects_help; projects_help; exit 0 ;;
            *) usage projects_help ;;
        esac
        method=call
        operation=project.list
        ;;
    eval)
        case ${2-} in
            '' ) usage eval_help ;;
            -h|--help)
                [ "$#" -eq 2 ] || usage eval_help
                eval_help
                exit 0
                ;;
            *)
                [ "$#" -eq 2 ] || usage eval_help
                code=$2
                ;;
        esac
        if [ "$code" = '-' ]; then
            code=$(command cat)
        fi
        method=call
        operation=elisp.eval
        argument_fields=
        add_string_argument code "$code"
        arguments="{$argument_fields}"
        ;;
    *) usage help ;;
esac

cwd=$PWD
if command -v cygpath >/dev/null 2>&1; then
    cwd=$(cygpath -w "$cwd")
fi
cwd_base64=$(printf '%s' "$cwd" | encode)
case $method in
    call)
        request=$(printf '{"version":1,"method":"call","operation":"%s","arguments":%s,"cwd_base64":"%s"}' \
            "$operation" "$arguments" "$cwd_base64")
        ;;
    hook)
        request=$(printf '{"version":1,"method":"hook","provider":"%s","session_base64":"%s","server_base64":"%s","pane_base64":"%s","payload_base64":"%s","cwd_base64":"%s"}' \
            "$provider" "$session_base64" "$server_base64" "$pane_base64" "$payload_base64" "$cwd_base64")
        ;;
    *)
        request=$(printf '{"version":1,"method":"%s","cwd_base64":"%s"}' \
            "$method" "$cwd_base64")
        ;;
esac

encoded=$(printf '%s' "$request" | encode)
case $encoded in
    *[!A-Za-z0-9+/=]*) fail 'limen: failed to encode request' 5 ;;
esac

case $operation in
    compile.*)
        expression="(progn (require 'limen) (require 'limen-compile) (limen-server-dispatch \"$encoded\"))"
        ;;
    trail.*)
        expression="(progn (require 'limen) (require 'limen-trail) (limen-server-dispatch \"$encoded\"))"
        ;;
    annotation.*)
        expression="(progn (require 'limen) (require 'limen-scholia nil t) (limen-server-dispatch \"$encoded\"))"
        ;;
    context.*)
        expression="(progn (require 'limen) (require 'limen-compile) (require 'limen-trail) (require 'limen-scholia nil t) (limen-server-dispatch \"$encoded\"))"
        ;;
    *)
        expression="(progn (require 'limen) (limen-server-dispatch \"$encoded\"))"
        ;;
esac
case $method in
    hook)
        expression="(progn (require 'limen) (require 'limen-hooks nil t) (limen-server-dispatch \"$encoded\"))"
        ;;
esac
if [ -n "$quiet" ]; then
    response_file=$(mktemp "${TMPDIR:-/tmp}/limen-hook.XXXXXX") || exit 0
    exec 3>&2 2>/dev/null
    "$emacsclient" --eval "$expression" >"$response_file" 3>&- &
    client=$!
    ( sleep "${LIMEN_HOOK_TIMEOUT:-3}"; kill "$client" ) >/dev/null 2>&1 3>&- &
    watchdog=$!
    client_status=0
    wait "$client" || client_status=$?
    kill "$watchdog" || :
    wait "$watchdog" || :
    exec 2>&3 3>&-
    response=$(cat "$response_file")
    rm -f "$response_file"
    [ "$client_status" -eq 0 ] || exit 0
elif ! response=$("$emacsclient" --eval "$expression"); then
    fail 'limen: local Emacs server or interface unavailable' 4
fi

response=${response#\"}
response=${response%\"}
case $response in
    [0-9]*:*) ;;
    \*ERROR\*:*) fail "limen: Emacs answered ${response#\*ERROR\*: }" 5 ;;
    *) fail 'limen: malformed response from Emacs' 5 ;;
esac
status=${response%%:*}
payload=${response#*:}
case $status in
    *[!0-9]*|'') fail 'limen: malformed response status' 5 ;;
esac
case $payload in
    *[!A-Za-z0-9+/=]*) fail 'limen: malformed response payload' 5 ;;
esac

if ! decoded=$(printf '%s' "$payload" | decode); then
    fail 'limen: malformed response encoding' 5
fi
if [ -n "$quiet" ]; then
    if [ "$status" -eq 0 ] && [ -n "$decoded" ]; then
        printf '%s\n' "$decoded"
    fi
    exit 0
fi
printf '%s\n' "$decoded"
exit "$status"
